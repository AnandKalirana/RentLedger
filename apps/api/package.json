    "test:coverage": "vitest run --coverage",
    "rag:backfill": "tsx src/rag/backfill.ts"
  },
  "dependencies": {
    "@rentledger/database": "*",
    "@rentledger/shared": "*",
    "@supabase/supabase-js": "^2.45.4",
