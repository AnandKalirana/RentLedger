# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL with pgvector extension)
# When using Supabase or PgBouncer, use port 6543 with ?pgbouncer=true for the app connection pool
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (port 5432) used for Prisma migrations
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# JWT & Session
JWT_ACCESS_SECRET=supersecretaccesskey1234567890
JWT_REFRESH_SECRET=supersecretrefreshkey1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=supersecretcookiekey1234567890

# Storage
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rentledger.local

# RAG & LLM Providers (gemini | ollama | mock)
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock
EMBEDDING_DIM=768

# Google Gemini (if using gemini provider)
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Ollama (if using ollama provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2
