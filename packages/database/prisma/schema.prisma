// RentLedger — Database Schema
// Multi-tenant SaaS: every Landlord owns an isolated set of Tenants, PaymentLinks, and Payments.
// All child models carry a direct landlordId FK (denormalized on purpose) so every query
// can be scoped and indexed by tenant (landlord) without joining through intermediate tables.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentLinkType {
  REUSABLE // Generic link, shared with any tenant; tenant fills their own details
  TENANT_SPECIFIC // Pre-filled for one tenant, still safe to share (no other tenant's data exposed)
}

enum TenantStatus {
  ACTIVE
  INACTIVE // Moved out / lease ended, kept for historical records
}

// Roles: LANDLORD = full owner, MANAGER = can do everything except billing/account,
// TENANT_VIEWER = read-only view of tenants assigned to them.
// Existing users default to LANDLORD so no data migration is required.
enum UserRole {
  LANDLORD
  MANAGER
  TENANT_VIEWER
}

// ---------------------------------------------------------------------------
// Landlord (application user / account owner)
// ---------------------------------------------------------------------------

model Landlord {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  fullName     String
  phone        String?
  businessName String? // Optional display name shown on tenant-facing payment page
  upiId        String? // Landlord's UPI VPA, used to render the QR code on the payment page
  upiQrImageUrl String? // Optional pre-generated QR image (cloud storage URL)

  // Role: set at account creation, never accepted from client input.
  // Existing rows default to LANDLORD via the migration default.
  role         UserRole @default(LANDLORD)

  isEmailVerified Boolean @default(false)
  emailVerifiedAt DateTime?

  passwordResetToken  String?   @unique
  passwordResetExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants        Tenant[]
  paymentLinks   PaymentLink[]
  payments       Payment[]
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  maintenanceRecords MaintenanceRecord[]

  @@index([email])
  @@map("landlords")
}

// ---------------------------------------------------------------------------
// Auth support — refresh tokens stored server-side so they can be revoked
// ---------------------------------------------------------------------------

model RefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // never store the raw token, only its hash
  landlordId String
  landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([landlordId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Tenant (a landlord's renter — NOT an application user, has no login)
// ---------------------------------------------------------------------------

model Tenant {
  id         String   @id @default(cuid())
  landlordId String
  landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  fullName      String
  mobileNumber  String
  email         String?
  monthlyRent   Decimal  @db.Decimal(10, 2)
  monthlyMaintenance Decimal? @db.Decimal(10, 2) @default(0)
  securityDeposit Decimal @db.Decimal(10, 2) @default(0)
  moveInDate    DateTime
  rentDueDay    Int      @default(1) // day of month, 1-31
  status        TenantStatus @default(ACTIVE)
  leaseDocumentUrl String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments           Payment[]
  paymentLinks       PaymentLink[]
  maintenanceRecords MaintenanceRecord[]

  @@index([landlordId])
  @@index([landlordId, status])
  @@map("tenants")
}

// ---------------------------------------------------------------------------
// PaymentLink — the shareable public link tenants use to submit payment proof
// ---------------------------------------------------------------------------

model PaymentLink {
  id         String   @id @default(cuid())
  landlordId String
  landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  tenantId String? // null when type = REUSABLE
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  token    String          @unique @default(cuid()) // public, unguessable identifier used in the URL
  type     PaymentLinkType @default(REUSABLE)
  isActive Boolean         @default(true)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([landlordId])
  @@index([token])
  @@map("payment_links")
}

// ---------------------------------------------------------------------------
// Payment — a single rent submission, pending manual verification
// ---------------------------------------------------------------------------

model Payment {
  id         String   @id @default(cuid())
  landlordId String
  landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  paymentLinkId String?
  paymentLink   PaymentLink? @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)

  // Snapshot of what the submitter entered — kept even if the Tenant record later changes
  submittedName   String
  submittedMobile String
  submittedEmail  String?

  amount Decimal @db.Decimal(10, 2)

  // Which rent cycle this payment is for, so dues/history can be reconciled
  billingMonth Int // 1-12
  billingYear  Int

  proofFileUrl  String // cloud storage URL of the uploaded proof image
  proofFileType String // mime type, validated at upload time

  status         PaymentStatus @default(PENDING)
  rejectionReason String?
  verifiedAt     DateTime?
  verifiedByLandlordId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([landlordId])
  @@index([landlordId, status])
  @@index([tenantId])
  @@index([landlordId, billingYear, billingMonth])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Notification — in-app notifications (e.g. "New payment submitted")
// ---------------------------------------------------------------------------

model Notification {
  id         String   @id @default(cuid())
  landlordId String
  landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  type    String // e.g. "PAYMENT_SUBMITTED", "PAYMENT_VERIFIED"
  title   String
  message String
  isRead  Boolean @default(false)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([landlordId, isRead])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// MaintenanceRecord — tracking monthly property/tenant maintenance payments
// ---------------------------------------------------------------------------

model MaintenanceRecord {
  id         String   @id @default(cuid())
  landlordId String
  landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  amount       Decimal       @db.Decimal(10, 2)
  billingMonth Int
  billingYear  Int
  status       PaymentStatus @default(PENDING) // PENDING, VERIFIED, REJECTED
  notes        String?
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([landlordId])
  @@index([tenantId])
  @@index([landlordId, billingYear, billingMonth])
  @@map("maintenance_records")
}

// ---------------------------------------------------------------------------
// AuditLog — every retrieval and sensitive action is logged here
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  landlordId   String
  actorId      String   // who performed the action (= landlordId for now, extensible to staff)
  actorRole    UserRole
  action       String   // e.g. "RAG_RETRIEVE", "CHAT_QUERY", "PAYMENT_VERIFY"
  resourceType String   // e.g. "DocumentChunk", "Payment", "Tenant"
  resourceIds  String[] // array of affected IDs
  query        String?  // natural language query, if applicable

  createdAt DateTime @default(now())

  @@index([landlordId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Enums for DocumentChunk
// ---------------------------------------------------------------------------

// The type of source data this chunk was generated from
enum ChunkSourceType {
  PAYMENT          // a single payment record
  TENANT_NOTE      // notes field on a tenant profile
  REJECTION_REASON // rejection reason on a payment
}

// Minimum role required to see this chunk in retrieval results.
// Must map to UserRole — lower number (LANDLORD=0) means most restrictive if
// we use "visible to this role and all more-privileged roles" semantics:
//   LANDLORD => only LANDLORD can see it
//   MANAGER  => LANDLORD and MANAGER can see it
//   TENANT_VIEWER => everyone can see it
enum ChunkVisibility {
  LANDLORD      // only the owning landlord
  MANAGER       // landlord + manager
  TENANT_VIEWER // all authenticated roles
}

// ---------------------------------------------------------------------------
// DocumentChunk — vector store for RAG retrieval
// ---------------------------------------------------------------------------

model DocumentChunk {
  id         String   @id @default(cuid())
  landlordId String   // denormalized, required for per-landlord filtering in vector search

  tenantId   String?  // nullable — some chunks relate to a payment not tied to a named tenant

  sourceType  ChunkSourceType
  sourceId    String           // FK-like: the Prisma record ID the chunk was derived from
  chunkIndex  Int              @default(0) // 0-based position when a source produces multiple chunks

  content     String           // plain-text chunk content fed into the LLM context
  visibility  ChunkVisibility  @default(TENANT_VIEWER)

  // The actual vector is stored in a pgvector column added by a raw SQL migration.
  // Prisma cannot express vector(N) natively, so the column is created via raw SQL
  // and the embedding is written/read through $queryRaw / $executeRaw.
  // This field is a placeholder so Prisma knows the column exists.
  // embedding  Unsupported("vector(768)")  <-- managed by raw migration, not here

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([landlordId, sourceType, sourceId, chunkIndex])
  @@index([landlordId])
  @@index([landlordId, sourceType])
  @@index([tenantId])
  @@map("document_chunks")
}

